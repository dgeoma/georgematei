---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://api.leadconnectorhq.com">
<link rel="preconnect" href="https://stcdn.leadconnectorhq.com" crossorigin>
<link rel="preconnect" href="https://link.msgsndr.com">
<title>Prenota 30 minuti · George Matei</title>
<meta name="description" content="Prenota una chiamata conoscitiva gratuita di trenta minuti: mi racconti come lavorate e alla fine sai se e da dove conviene partire con l'AI.">
<meta property="og:title" content="Prenota 30 minuti con George Matei">
<meta property="og:description" content="Trenta minuti in videochiamata, gratis. Alla fine sai se e da dove conviene partire con l'AI.">
<meta property="og:type" content="website">
<meta property="og:locale" content="it_IT">
<meta property="og:site_name" content="George Matei">
<meta property="og:url" content="https://georgematei.com/calendario/">
<meta property="og:image" content="https://georgematei.com/assets/og-george.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="George Matei, AI e automazioni per imprenditori">
<meta name="twitter:card" content="summary_large_image">
<link rel="canonical" href="https://georgematei.com/calendario/">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#0f1e3a">
<link rel="preload" href="/assets/fonts/montserrat-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/styles.css?v=22">
<style>
  .cal-page--solo { padding-top: 34px; }
  .cal-page__title { font-size: clamp(24px, 3vw, 32px); margin: 0 0 18px; }
  .cal-page__box { position: relative; }
  .cal-page__box iframe { position: relative; display: block; }
  .cal-page__wait { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: var(--muted); font-size: 15px; }
  @media (max-width: 380px) { .cal-page__title { padding: 0 10px; } }
  .cal-page__note--sotto { margin: 18px 0 0; }
</style>
</head>
<body>
<a class="skip" href="#calendario">Vai al calendario</a>

<Nav />

<main>
  <section class="cal-page cal-page--solo" id="prenota">
    <div class="wrap">
      <h1 class="cal-page__title">Prenota trenta minuti</h1>
      <div class="cal-page__box" id="calendario">
        <p class="cal-page__wait" id="cal-wait" aria-hidden="true">Carico il calendario…</p>
        <iframe src="https://api.leadconnectorhq.com/widget/booking/cPICakRP00QYGUi5Wyoi" title="Calendario prenotazioni di George Matei" id="cPICakRP00QYGUi5Wyoi_calendario" scrolling="no" allow="payment" onload="var w=document.getElementById('cal-wait');if(w)w.remove()" style="width:100%;border:none;overflow:hidden;min-height:620px"></iframe>
      </div>
      <p class="cal-page__note cal-page__note--sotto">Il calendario è di HighLevel e si carica con la pagina: registra la visita e salva nel browser identificativi, anche per le sue statistiche. <a href="/privacy/">Come tratto i tuoi dati</a>. Se sei già cliente di Marketing Genius, per qualunque cosa scrivi al tuo referente lì. Non vedi il calendario? Scrivimi a <a href="mailto:d.georgematei@gmail.com">d.georgematei@gmail.com</a>.</p>
    </div>
  </section>
</main>

<Footer />

<script is:inline>
  setTimeout(function () { var w = document.getElementById('cal-wait'); if (w) w.textContent = 'Il calendario non si carica? Scrivimi a d.georgematei@gmail.com'; }, 10000);
  (function () {
    var nav = document.querySelector('.nav');
    addEventListener('scroll', function () { nav.classList.toggle('is-scrolled', scrollY > 12); }, { passive: true });
  })();
</script>
<script is:inline src="https://link.msgsndr.com/js/form_embed.js" defer></script>
<script is:inline src="/nav.js?v=1" defer></script>
</body>
</html>
