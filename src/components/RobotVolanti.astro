---
// I due robot in volo dell'apertura in 3D vero (src/scripts/robot3d.ts). Si accende solo su desktop
// (≥981 px), senza «Riduci movimento» e con WebGL2; quando è pronto la classe .robot-3d sull'hero
// nasconde le due immagini piatte. Altrove restano le immagini di sempre.
---
<canvas class="robot3d" aria-hidden="true"></canvas>

<style is:global>
  .robot3d { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0; transition: opacity .8s ease; }
  .robot-3d .robot3d { opacity: 1; }
  .robot-3d .hero__cielo .volo { visibility: hidden; }
  @media (max-width: 980px), (prefers-reduced-motion: reduce) {
    .robot3d { display: none; }
    .robot-3d .hero__cielo .volo { visibility: visible; }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.robot3d');
  const cielo = document.querySelector<HTMLElement>('.hero__cielo');
  const ok = canvas && cielo
    && matchMedia('(min-width: 981px)').matches
    && !matchMedia('(prefers-reduced-motion: reduce)').matches
    && (() => { try { const gl = document.createElement('canvas').getContext('webgl2'); gl?.getExtension('WEBGL_lose_context')?.loseContext(); return !!gl; } catch { return false; } })();

  if (ok) {
    const via = async () => {
      const { avvia } = await import('../scripts/robot3d');
      avvia(canvas!, cielo!, document.querySelector('.hero'), document.querySelector('.volo__pausa'));
    };
    const quando = () => ('requestIdleCallback' in window ? requestIdleCallback(() => via(), { timeout: 1500 }) : setTimeout(via, 300));
    if (document.readyState === 'complete') quando(); else addEventListener('load', quando, { once: true });
  }
</script>
